{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CicadaFinScape",
  "mainBinaryName": "CicadaFinScape",
  "version": "0.1.0",
  "identifier": "com.daxmu.cicada",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run serve:web",
    "beforeBuildCommand": "npm run export:web"
  },
  "app": {
    "windows": [
      {
        "title": "CicadaFinScape",
        "width": 480,
        "height": 880,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless",
        "Cache-Control": "no-store"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
