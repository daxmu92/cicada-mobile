{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CicadaFinScape",
  "mainBinaryName": "CicadaFinScape",
  "version": "0.2.1",
  "identifier": "com.daxmu.cicada",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run serve:web",
    "beforeBuildCommand": "npm run export:web"
  },
  "app": {
    "windows": [
      {
        "title": "CicadaFinScape",
        "width": 480,
        "height": 880,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
